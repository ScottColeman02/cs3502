        </property>
        <property name="text">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;Thank you for using the File Manager! This help menu is designed to assist with getting started with this application.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;To begin click the button of the corresponding action you would like to perform. Before selecting any operation please ensure you have selected either a file or directory (whichever is required for the desired operation).&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;Please be aware that the only supported file types are .txt , .html , .htm , and .md. Attempting to display or update any other file types will result in errors. When creating a file or directory keep in mind that the following characters are illegal and will cause errors:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;? * &amp;lt; &amp;gt; / \ | : &amp;quot;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt;&quot;&gt;DO NOT ATTEMPT TO DELETE ANY SYSTEM FILES OR DIRECTORIES. DOING SO WILL CRASH File Manager!!&lt;/span&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
